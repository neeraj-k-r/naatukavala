# ---- Naatukavala environment template ----
# Local dev: copy to frontend/.env.local and backend/.env and fill in.
# Hosting: set these in each service's dashboard instead (see below).

# App
NEXT_PUBLIC_APP_NAME=Naatukavala
# Main domain (no protocol). Set to your real domain in production,
# e.g. naatukavala.com . Leave as localhost for local dev.
NEXT_PUBLIC_APP_DOMAIN=localhost
# Used to share auth cookies across shop subdomains. Set to .yourdomain.com in
# production (leading dot). Leave empty on localhost.
NEXT_PUBLIC_COOKIE_DOMAIN=
# FRONTEND (Vercel etc.): public URL of the backend API. Local dev default is
# http://localhost:4000 . Production e.g. https://your-api.onrender.com .
# NOTE: NEXT_PUBLIC_* vars are baked in at BUILD time — set before building.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase (https://supabase.com/dashboard -> project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY - never expose. Used by admin/server-side operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Superadmin account seeded by `npm run seed:superadmin`
SUPERADMIN_EMAIL=naatukavala.admin@gmail.com
SUPERADMIN_PASSWORD=set-a-strong-password
SUPERADMIN_NAME=Naattukavala Admin

# Cloudinary (https://cloudinary.com/console -> account details)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key
# SERVER ONLY
CLOUDINARY_API_SECRET=your-api-secret
# Signed upload preset for product images (recommended, limits public abuse).
CLOUDINARY_UPLOAD_PRESET=naatukavala_product

# BACKEND ONLY (Render/Railway etc.): comma-separated public frontend
# origin(s) allowed by CORS. Local dev falls back to http://localhost:3000.
# Production e.g. FRONTEND_URL=https://naatukavala.com
FRONTEND_URL=