# ---- Naatukavala backend environment template ----
# Local dev: copy to backend/.env and fill in.
# Hosting: set these in the backend service's env dashboard instead.

PORT=4000

# Comma-separated public frontend origin(s) allowed by CORS.
# Local dev falls back to http://localhost:3000 + http://127.0.0.1:3000.
# Production e.g. FRONTEND_URL=https://naatukavala.com
FRONTEND_URL=

# Supabase (https://supabase.com/dashboard -> project settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Cloudinary (https://cloudinary.com/console -> account details)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=naatukavala_product

# Superadmin account seeded by `npm run seed:superadmin`
SUPERADMIN_EMAIL=naatukavala.admin@gmail.com
SUPERADMIN_PASSWORD=set-a-strong-password
SUPERADMIN_NAME=Naattukavala Admin
